           fi
           echo "Axiom audit OK: $n headline results depend only on {propext, Classical.choice, Quot.sound}."
 
+      # The OAI265 layer is not a default target, so it is built here before its audit.
+      - name: Axiom audit (OpenAI/Audit.lean)
+        shell: bash
+        run: |
+          set -uo pipefail
+          set +e
+          lake build OpenAI || exit 1
+          expected="$(grep -cE '^#print axioms ' OpenAI/Audit.lean)"
+          if [ "$expected" -lt 1 ]; then
+            echo "::error::no '#print axioms' commands found in OpenAI/Audit.lean"; exit 1
+          fi
+          out="$(lake env lean OpenAI/Audit.lean 2>&1)"
+          echo "$out"
+          n="$(printf '%s\n' "$out" | grep -c 'depends on axioms')"
+          if [ "$n" -ne "$expected" ]; then
+            echo "::error::expected $expected audited results, saw $n (audit did not run, or a #print axioms failed)"; exit 1
+          fi
+          bad="$(printf '%s\n' "$out" | grep 'depends on axioms' \
+            | grep -oE '\[[^]]*\]' | tr -d '[]' | tr ',' '\n' | sed 's/[[:space:]]//g' \
+            | grep -vE '^(propext|Classical.choice|Quot.sound)$' | grep -v '^$' | sort -u)"
+          if [ -n "$bad" ]; then
+            echo "::error::disallowed axioms in OpenAI results:"; printf '  %s\n' "$bad"; exit 1
+          fi
+          echo "Axiom audit OK: $n OpenAI results depend only on {propext, Classical.choice, Quot.sound}."
+
   # Concurrent with `build`: text-based linting needs only the source files, so it
   # returns in seconds rather than waiting on a Mathlib build.
   style:
