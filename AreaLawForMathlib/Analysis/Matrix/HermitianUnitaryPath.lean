import Mathlib.Analysis.Normed.Algebra.MatrixExponential
import Mathlib.Analysis.SpecialFunctions.Exponential
import Mathlib.Analysis.Calculus.Deriv.Slope
import Mathlib.Analysis.Calculus.Deriv.Mul
import Mathlib.Analysis.Calculus.Deriv.Add
import Mathlib.Data.Matrix.Basis
import Mathlib.Analysis.CStarAlgebra.Matrix
import Mathlib.Tactic.FunProp
import Mathlib.Tactic.Push

/-!
# Hermitian exponential paths

Extends `Mathlib/Analysis/Normed/Algebra/MatrixExponential.lean`.

The punctured-neighborhood result uses differentiation and a matrix unit,
not eigenvalue enumeration or a trigonometric framework.
-/

open scoped Matrix Matrix.Norms.Operator
open Filter NormedSpace
open scoped Topology

namespace Matrix
variable {n : Type*} [Fintype n] [DecidableEq n]

/-- The continuous path generated by a Hermitian matrix. -/
noncomputable def hermitianUnitaryPath (H : Matrix n n ℂ) (t : ℝ) : Matrix n n ℂ :=
  exp (t • (Complex.I • H))

@[simp] theorem hermitianUnitaryPath_zero (H : Matrix n n ℂ) :
    hermitianUnitaryPath H 0 = 1 := by simp [hermitianUnitaryPath]

/-- The exponential path is continuous. -/
theorem continuous_hermitianUnitaryPath (H : Matrix n n ℂ) :
    Continuous (hermitianUnitaryPath H) := by
  unfold hermitianUnitaryPath
  fun_prop

/-- Hermitian generators give unitary matrices. -/
theorem hermitianUnitaryPath_mul_conjTranspose
    (H : Matrix n n ℂ) (hH : H.IsHermitian) (t : ℝ) :
    hermitianUnitaryPath H t * (hermitianUnitaryPath H t)ᴴ = 1 := by
  have hskew : (t • (Complex.I • H))ᴴ = -(t • (Complex.I • H)) := by
    simp [Matrix.conjTranspose_smul, hH.eq]
  change exp (t • (Complex.I • H)) * (exp (t • (Complex.I • H)))ᴴ = 1
  rw [← Matrix.exp_conjTranspose, hskew,
    ← Matrix.exp_add_of_commute (t • (Complex.I • H)) (-(t • (Complex.I • H)))
      (Commute.refl (t • (Complex.I • H))).neg_right]
  simp

/-- A differentiable curve with nonzero derivative and zero initial value
is nonzero in a punctured neighborhood of its initial parameter. -/
private theorem eventually_ne_zero_of_hasDerivAt
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {f : ℝ → E} {v : E} (hf : HasDerivAt f v 0) (hf0 : f 0 = 0) (hv : v ≠ 0) :
    ∀ᶠ t in 𝓝[≠] (0 : ℝ), f t ≠ 0 := by
  have hs : ∀ᶠ t in 𝓝[≠] (0 : ℝ), slope f 0 t ≠ 0 :=
    hf.tendsto_slope (isClosed_singleton.isOpen_compl.mem_nhds hv)
  filter_upwards [hs] with t ht
  intro hft
  apply ht
  simp [slope, hf0, hft]

end Matrix
