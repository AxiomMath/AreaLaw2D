import AreaLawForMathlib.RepresentationTheory.SchurWeyl.TensorPowerAction

/-!
# Commutation of Schur labels and complementary labels on the symmetric subspace

Extends `Mathlib/RepresentationTheory/Basic.lean`.
-/

open MonoidAlgebra Matrix

namespace PermutationRepresentation

variable {G X : Type*} [Group G] [Fintype X] [DecidableEq X]

/-- A central group-algebra element commutes with every permutation operator. -/
theorem commute_groupAlgebraRep_permOp_of_mem_center (φ : G →* Equiv.Perm X)
    {a : MonoidAlgebra ℂ G} (ha : a ∈ Subalgebra.center ℂ (MonoidAlgebra ℂ G)) (g : G) :
    Commute (groupAlgebraRep φ a) (permOp φ g) := by
  rw [Commute, SemiconjBy, ← one_smul ℂ (permOp φ g), ← groupAlgebraRep_single, ← map_mul,
    ← map_mul, Subalgebra.mem_center_iff.mp ha]

theorem permOp_of_eq_mul (φ χ ψ : G →* Equiv.Perm X) (hψ : ∀ g, ψ g = φ g * χ g) (g : G) :
    permOp ψ g = permOp φ g * permOp χ g := by
  rw [permOp_apply, permOp_apply, permOp_apply, hψ, _root_.mul_inv_rev, permMatrix_mul]

/-- A central function of one factor commutes with operators generated by the product. -/
theorem commute_groupAlgebraRep_of_eq_mul (φ χ ψ : G →* Equiv.Perm X)
    (hψ : ∀ g, ψ g = φ g * χ g) (hcomm : ∀ g h, Commute (φ g) (χ h))
    {a : MonoidAlgebra ℂ G} (ha : a ∈ Subalgebra.center ℂ (MonoidAlgebra ℂ G))
    (b : MonoidAlgebra ℂ G) : Commute (groupAlgebraRep φ a) (groupAlgebraRep ψ b) := by
  refine (commute_groupAlgebraRep_of_forall_commute ψ (fun g => ?_) b).symm
  rw [permOp_of_eq_mul φ χ ψ hψ g]
  refine Commute.mul_left (commute_groupAlgebraRep_permOp_of_mem_center φ ha g).symm ?_
  simpa using (commute_groupAlgebraRep_of_commute φ χ hcomm a (single g 1)).symm

/-- Complementary central functions agree on vectors fixed by the product action. -/
theorem groupAlgebraRep_mulVec_eq_of_eq_mul [Finite G] (φ χ ψ : G →* Equiv.Perm X)
    (hψ : ∀ g, ψ g = φ g * χ g) {a : MonoidAlgebra ℂ G}
    (hinv : ∀ g, a.coeff g⁻¹ = a.coeff g) {v : X → ℂ} (hv : v ∈ invariantSubspace ψ) :
    groupAlgebraRep φ a *ᵥ v = groupAlgebraRep χ a *ᵥ v := by
  have := Fintype.ofFinite G
  have key : ∀ g, permOp χ g *ᵥ v = permOp φ g⁻¹ *ᵥ v := fun g => by
    have h1 := hv g
    rw [permOp_of_eq_mul φ χ ψ hψ g, ← mulVec_mulVec] at h1
    calc permOp χ g *ᵥ v = permOp φ g⁻¹ *ᵥ (permOp φ g *ᵥ (permOp χ g *ᵥ v)) := by
          rw [mulVec_mulVec, permOp_inv_mul_self, one_mulVec]
      _ = permOp φ g⁻¹ *ᵥ v := by rw [h1]
  rw [groupAlgebraRep_eq_sum, groupAlgebraRep_eq_sum, sum_mulVec, sum_mulVec]
  simp_rw [smul_mulVec, key]
  exact Fintype.sum_equiv (Equiv.inv G) _ _ fun g => by rw [Equiv.inv_apply, inv_inv, hinv]

end PermutationRepresentation

namespace TensorPower

open PermutationRepresentation

variable {F : Type*} [DecidableEq F] (ι : F → Type*) [∀ f, Fintype (ι f)]
  [∀ f, DecidableEq (ι f)] (k : ℕ) [Fintype F]

theorem commute_groupAlgebraRep_subsystemPerm_of_disjoint {Q Q' : Finset F}
    (h : Disjoint Q Q') (a b : MonoidAlgebra ℂ (Equiv.Perm (Fin k))) :
    Commute (groupAlgebraRep (subsystemPerm k ι Q) a)
      (groupAlgebraRep (subsystemPerm k ι Q') b) :=
  commute_groupAlgebraRep_of_commute _ _ (commute_subsystemPerm_of_disjoint k ι h) a b

theorem commute_groupAlgebraRep_subsystemPerm_of_subset {Q Q' : Finset F} (h : Q ⊆ Q')
    {a : MonoidAlgebra ℂ (Equiv.Perm (Fin k))}
    (ha : a ∈ Subalgebra.center ℂ (MonoidAlgebra ℂ (Equiv.Perm (Fin k))))
    (b : MonoidAlgebra ℂ (Equiv.Perm (Fin k))) :
    Commute (groupAlgebraRep (subsystemPerm k ι Q) a)
      (groupAlgebraRep (subsystemPerm k ι Q') b) := by
  refine commute_groupAlgebraRep_of_eq_mul _ (subsystemPerm k ι (Q' \ Q)) _ (fun σ => ?_)
    (commute_subsystemPerm_of_disjoint k ι Finset.disjoint_sdiff) ha b
  conv_lhs => rw [← Finset.union_sdiff_of_subset h]
  exact subsystemPerm_union k ι Finset.disjoint_sdiff σ

theorem commute_labelProj_subsystemPerm_of_disjoint {Q Q' : Finset F} (h : Disjoint Q Q')
    (l l' : IrrepLabel (Equiv.Perm (Fin k))) :
    Commute (labelProj (subsystemPerm k ι Q) l) (labelProj (subsystemPerm k ι Q') l') :=
  commute_groupAlgebraRep_subsystemPerm_of_disjoint ι k h _ _

end TensorPower
